// Maeyja — e-commerce data model.
// Money is Decimal(12,2) in TRY and VAT-inclusive; the backend is the only price authority.
// `translations` columns hold non-default locales, e.g. { "en": { "name": "...", "description": "..." } }.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum UserRole {
  CUSTOMER
  EDITOR // content only (journal, pages, home, press)
  ADMIN // everything except managing admins
  SUPER_ADMIN
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  IYZICO
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum HomeSectionType {
  HERO
  FEATURED_PRODUCTS
  COLLECTION
  EDITORIAL
  CRAFT_STORY
  PRESS
  STOCKISTS
  NEWSLETTER
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum PushTarget {
  ALL
  USERS
}

enum PushStatus {
  PENDING
  SENT
  FAILED
}

// ─────────────────────────────── Identity ───────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String?
  firstName       String?
  lastName        String?
  phone           String?
  role            UserRole  @default(CUSTOMER)
  locale          String    @default("tr")
  marketingOptIn  Boolean   @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  mfaSecret       String? // AES-256-GCM encrypted TOTP secret (staff only)
  mfaEnabledAt    DateTime?
  mfaBackupCodes  String[]  @default([]) // sha256 hashes, single use
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  addresses      Address[]
  refreshTokens  RefreshToken[]
  authTokens     AuthToken[]
  orders         Order[]
  cart           Cart?
  wishlist       WishlistItem[]
  devices        UserDevice[]
  returnRequests ReturnRequest[]

  @@index([role])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  title      String? // "Ev", "Ofis"
  firstName  String
  lastName   String
  phone      String
  country    String   @default("TR")
  city       String
  district   String
  line1      String
  line2      String?
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────── Catalog ───────────────────────────────

model Category {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  imageUrl       String?
  parentId       String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  translations   Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Collection {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  description    String?
  coverImageUrl  String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  translations   Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products ProductCollection[]
}

model Color {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  hex          String // swatch, e.g. "#B3121B"; bicolor uses `hex2`
  hex2         String?
  sortOrder    Int     @default(0)
  translations Json?

  variants ProductVariant[]
  images   ProductImage[]
}

model Product {
  id             String        @id @default(cuid())
  slug           String        @unique
  name           String
  subtitle       String?
  description    String?       @db.Text
  story          String?       @db.Text // craftsmanship narrative for the PDP
  material       String?
  care           String?       @db.Text
  dimensions     String?
  madeIn         String?       @default("Türkiye")
  sizeGuide      String?       @db.Text
  status         ProductStatus @default(DRAFT)
  isFeatured     Boolean       @default(false)
  basePrice      Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  taxRate        Int? // VAT % included in price; null → settings.tax.defaultRate
  categoryId     String?
  sortOrder      Int           @default(0)
  tags           String[]
  translations   Json?
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants     ProductVariant[]
  images       ProductImage[]
  collections  ProductCollection[]
  wishlistedBy WishlistItem[]

  @@index([status, deletedAt])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  sortOrder    Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

/// A sellable unit: colour × size. Bags usually have colour only, clothing has both.
model ProductVariant {
  id             String    @id @default(cuid())
  productId      String
  sku            String    @unique
  colorId        String?
  size           String?
  price          Decimal?  @db.Decimal(12, 2) // null → product.basePrice
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  stock          Int       @default(0)
  barcode        String?
  weightGrams    Int?
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color       Color?       @relation(fields: [colorId], references: [id], onDelete: SetNull)
  cartItems   CartItem[]
  stockAlerts StockAlert[]

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  colorId   String? // image belongs to a colour → PDP swaps gallery on swatch click
  url       String
  alt       String?
  width     Int?
  height    Int?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   Color?  @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
}

// ─────────────────────────────── Cart & wishlist ───────────────────────────────

model Cart {
  id         String   @id @default(cuid())
  userId     String?  @unique
  guestToken String?  @unique // sent by guests as X-Cart-Token
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([updatedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model StockAlert {
  id         String    @id @default(cuid())
  variantId  String
  email      String
  locale     String    @default("tr")
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, email])
  @@index([notifiedAt])
}

// ─────────────────────────────── Promotions ───────────────────────────────

model Coupon {
  id                String     @id @default(cuid())
  code              String     @unique
  description       String?
  type              CouponType
  value             Decimal    @default(0) @db.Decimal(12, 2) // % for PERCENT, TRY for FIXED
  minOrderAmount    Decimal?   @db.Decimal(12, 2)
  maxDiscount       Decimal?   @db.Decimal(12, 2)
  usageLimit        Int?
  usageLimitPerUser Int?
  usedCount         Int        @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  email     String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, email])
}

// ─────────────────────────────── Orders & payments ───────────────────────────────

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String?
  email           String
  phone           String?
  status          OrderStatus     @default(PENDING_PAYMENT)
  currency        String          @default("TRY")
  subtotal        Decimal         @db.Decimal(12, 2)
  discountTotal   Decimal         @default(0) @db.Decimal(12, 2)
  shippingTotal   Decimal         @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal         @default(0) @db.Decimal(12, 2) // VAT contained in total (informational)
  total           Decimal         @db.Decimal(12, 2)
  couponCode      String?
  paymentProvider PaymentProvider
  shippingAddress Json
  billingAddress  Json
  customerNote    String?
  adminNote       String?
  carrier         String?
  trackingNumber  String?
  trackingUrl     String?
  locale          String          @default("tr")
  ip              String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  stockReleasedAt DateTime? // set once reserved stock has been returned (idempotency guard)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  history          OrderStatusHistory[]
  couponRedemption CouponRedemption?
  returnRequests   ReturnRequest[]

  @@index([userId])
  @@index([status, createdAt])
  @@index([email])
}

/// Snapshot of what was bought — never re-read prices/names from the catalog.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  variantId   String?
  productName String
  variantName String?
  sku         String
  colorName   String?
  size        String?
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)
  taxRate     Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderStatusHistory {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("TRY")
  providerToken     String?         @unique // iyzico checkout-form token
  providerPaymentId String?
  cardLast4         String?
  cardAssociation   String?
  installment       Int?
  failureReason     String?
  raw               Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model ReturnRequest {
  id         String       @id @default(cuid())
  orderId    String
  userId     String?
  email      String
  reason     String
  items      Json // [{ orderItemId, quantity }]
  status     ReturnStatus @default(REQUESTED)
  adminNote  String?
  refundedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ─────────────────────────────── Content ───────────────────────────────

model HomeSection {
  id             String          @id @default(cuid())
  type           HomeSectionType
  title          String?
  subtitle       String?
  body           String?         @db.Text
  imageUrl       String?
  mobileImageUrl String?
  videoUrl       String?
  ctaLabel       String?
  ctaUrl         String?
  payload        Json? // type-specific, e.g. { productIds: [] } or { collectionSlug }
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  translations   Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique // about, shipping-returns, privacy, kvkk, distance-sales, terms
  title          String
  body           String        @db.Text
  status         ContentStatus @default(PUBLISHED)
  translations   Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model JournalPost {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  excerpt        String?
  body           String        @db.Text
  coverImageUrl  String?
  status         ContentStatus @default(DRAFT)
  publishedAt    DateTime?
  translations   Json?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model PressItem {
  id          String    @id @default(cuid())
  publication String // "Vogue Türkiye"
  title       String?
  quote       String?
  url         String?
  logoUrl     String?
  imageUrl    String?
  publishedAt DateTime?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model Stockist {
  id        String   @id @default(cuid())
  name      String // "Beymen İstinye"
  city      String
  country   String   @default("TR")
  address   String?
  phone     String?
  url       String?
  mapUrl    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Faq {
  id           String   @id @default(cuid())
  group        String? // "Sipariş", "Kargo", "Bakım"
  question     String
  answer       String   @db.Text
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  translations Json?
  createdAt    DateTime @default(now())
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String    @default("tr")
  source         String?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Media {
  id           String   @id @default(cuid())
  url          String // largest rendition
  key          String   @unique // storage path relative to UPLOAD_DIR
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  renditions   Json? // { "400": url, "800": url, "1600": url }
  uploadedById String?
  createdAt    DateTime @default(now())
}

// ─────────────────────────────── Push & system ───────────────────────────────

/// Mobile/web push subscriptions. OneSignal identifies users by external_id = User.id,
/// this table is for analytics and targeting by platform.
model UserDevice {
  id             String         @id @default(cuid())
  userId         String?
  subscriptionId String         @unique // OneSignal subscription id
  platform       DevicePlatform
  appVersion     String?
  isActive       Boolean        @default(true)
  lastSeenAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model PushCampaign {
  id            String     @id @default(cuid())
  title         String
  body          String
  url           String?
  imageUrl      String?
  target        PushTarget @default(ALL)
  targetUserIds String[]
  status        PushStatus @default(PENDING)
  providerId    String?
  recipients    Int?
  error         String?
  createdById   String?
  sentAt        DateTime?
  createdAt     DateTime   @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // "POST /api/admin/products"
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ───────── E-mail campaigns (marketing; only to people who opted in) ─────────
enum CampaignStatus {
  DRAFT
  SENDING
  SENT
  CANCELLED
}

enum CampaignAudience {
  ALL // newsletter subscribers + customers who opted in
  SUBSCRIBERS // newsletter subscribers only
  CUSTOMERS // registered customers who opted in
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model EmailCampaign {
  id              String           @id @default(cuid())
  subject         String
  preheader       String? // preview line shown next to the subject in the inbox
  title           String? // heading inside the email
  body            String           @db.Text // sanitised HTML
  ctaLabel        String?
  ctaUrl          String?
  audience        CampaignAudience @default(ALL)
  locale          String? // null → every language
  status          CampaignStatus   @default(DRAFT)
  totalRecipients Int              @default(0)
  sentCount       Int              @default(0)
  failedCount     Int              @default(0)
  createdById     String?
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  recipients EmailCampaignRecipient[]

  @@index([status])
}

/** Snapshot of the audience at send time; lets an interrupted send resume without mailing anyone twice. */
model EmailCampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  email      String
  locale     String                  @default("tr")
  status     CampaignRecipientStatus @default(PENDING)
  error      String?
  sentAt     DateTime?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@index([campaignId, status])
}
