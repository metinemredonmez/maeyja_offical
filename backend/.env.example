# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
# nginx arkasında loopback'te kal; dışarıdan :4000'e erişim olmasın
LISTEN_HOST=127.0.0.1
API_PREFIX=api
# Behind nginx on the server: number of proxy hops to trust for client IPs
TRUST_PROXY=1

# Public URLs (no trailing slash)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ───────── Database (PostgreSQL, no Docker on the server) ─────────
DATABASE_URL=postgresql://maeyja:CHANGE_ME@localhost:5432/maeyja?schema=public

# ───────── Auth ─────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# openssl rand -base64 32 — TOTP sırlarını şifreler
APP_ENCRYPTION_KEY=
# Prod'da true: yönetici hesapları iki adımlı doğrulama kurmadan admin uçlarını kullanamaz
# Staff two-step verification. Unset: required in production. false switches it off (not recommended).
MFA_REQUIRED_FOR_STAFF=true

# ───────── Uploads (local disk, served by nginx in prod) ─────────
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=http://localhost:4000/uploads
UPLOAD_MAX_MB=15

# ───────── Mail (SMTP) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MAEYJA <hello@maeyja.com>"
# Müşteri otomatik maile "yanıtla" derse cevap buraya gider (boş → MAIL_FROM)
MAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

# ───────── Payments: iyzico checkout form ─────────
# Card payments: STRIPE (default) or IYZICO. Stripe keys: dashboard.stripe.com → Developers.
# A restricted key (rk_live_…) is preferred; the webhook secret comes from the webhook endpoint
# https://api.maeyja.com/api/payments/stripe/webhook (events: checkout.session.*).
CARD_PROVIDER=STRIPE
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ───────── Push: OneSignal (FCM/APNs keys live in the OneSignal dashboard) ─────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Claude — otomatik çeviri (boşsa kapalı); AI_AUTO_TRANSLATE=false ile yalnızca admin düğmesi çalışır
ANTHROPIC_API_KEY=
AI_AUTO_TRANSLATE=true
# Mağaza asistanı: tüm site için günlük mesaj üst sınırı
AI_CHAT_DAILY_LIMIT=1500

# Gemini — "Üzerimde gör" sanal deneme (boşsa kapalı) ve günlük görsel sınırı
GEMINI_API_KEY=
TRYON_DAILY_LIMIT=100
AI_SEARCH_DAILY_LIMIT=500
AI_ADMIN_DAILY_LIMIT=400

# Instagram — ana sayfadaki "Instagram'da takip et" fotoğrafları (boşsa kampanya fotoğrafları kalır).
# Uzun ömürlü token; API onu haftada bir kendisi yeniler.
INSTAGRAM_ACCESS_TOKEN=

# Yedek betiğinin (deploy/backup.sh) her gece yazdığı durum dosyası; boşsa prod'da /var/lib/maeyja/backup-status.json.
# 30 saatten eskiyse ya da son yedek hata verdiyse uyarı gelir.
BACKUP_STATUS_FILE=

# ───────── Orders ─────────
ORDER_PAYMENT_TIMEOUT_MINUTES=30
BANK_TRANSFER_TIMEOUT_HOURS=48

# ───────── Misc ─────────
# Prod'da daima false (Joi zorlar); yerelde true yapabilirsin
SWAGGER_ENABLED=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# İlk kurulumda `npm run db:seed` süper admini oluşturur. Prod'da ≥15 karakter zorunlu; ilk girişten sonra bu iki satırı SİL.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
