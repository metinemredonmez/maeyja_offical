# ───────── Runtime ─────────
NODE_ENV=development
PORT=4000
API_PREFIX=api
# Behind nginx on the server: number of proxy hops to trust for client IPs
TRUST_PROXY=1

# Public URLs (no trailing slash)
API_URL=http://localhost:4000
WEB_URL=http://localhost:3001
ADMIN_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ───────── Database (PostgreSQL, no Docker on the server) ─────────
DATABASE_URL=postgresql://maeyja:CHANGE_ME@localhost:5432/maeyja?schema=public

# ───────── Auth ─────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# ───────── Uploads (local disk, served by nginx in prod) ─────────
UPLOAD_DIR=./uploads
UPLOAD_PUBLIC_URL=http://localhost:4000/uploads
UPLOAD_MAX_MB=15

# ───────── Mail (SMTP) ─────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MAEYJA <hello@maeyja.com>"
ADMIN_NOTIFY_EMAIL=

# ───────── Payments: iyzico checkout form ─────────
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ───────── Push: OneSignal (FCM/APNs keys live in the OneSignal dashboard) ─────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ───────── Orders ─────────
ORDER_PAYMENT_TIMEOUT_MINUTES=30
BANK_TRANSFER_TIMEOUT_HOURS=48

# ───────── Misc ─────────
SWAGGER_ENABLED=true
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Used once by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@maeyja.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
