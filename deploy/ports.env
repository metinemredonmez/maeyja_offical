# Paylaşımlı sunucuda (hazal-*, playce-*, ogulcanates-web ile aynı makine) çakışmayan loopback portları.
# ecosystem.config.js ve deploy.sh bu dosyayı okur. Değiştirirsen nginx-maeyja.conf'taki proxy_pass satırlarını da güncelle.
# Boş port bulmak için sunucuda:  ss -tlnp | grep -E ':(4100|3100|3101)\b'  (çıktı boşsa serbest)
API_PORT=4100
WEB_PORT=3101
ADMIN_PORT=3100
